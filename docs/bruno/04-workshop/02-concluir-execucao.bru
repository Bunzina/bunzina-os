meta {
  name: Concluir execucao
  type: http
  seq: 2
}

patch {
  url: {{workshopBaseUrl}}/executions/{{serviceOrderId}}/items
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "services": [
      {
        "serviceId": "{{serviceId}}"
      }
    ]
  }
}

docs {
  Rode depois do pagamento confirmado. Quando todos os servicos terminam, publica evt.workshop.execution-completed.
}
