meta {
  name: Criar veiculo
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/vehicles
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "customerId": "{{customerId}}",
    "licensePlate": "{{licensePlate}}",
    "model": "Corolla",
    "brand": "Toyota",
    "year": 2020
  }
}

script:post-response {
  const id = res.body?.id;
  if (res.status >= 200 && res.status < 300 && id) {
    bru.setEnvVar("vehicleId", id);
    bru.setVar("vehicleId", id);
  }
}
